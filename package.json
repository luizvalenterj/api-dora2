{
  "name": "health-network-api",
  "version": "1.0.0",
  "private": true,
  "description": "API intermediaria entre agentes LLM e o indice Algolia de rede credenciada",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.test.json",
    "smoke": "tsx --env-file-if-exists=.env scripts/smoke.ts",
    "test:integration": "RUN_INTEGRATION=1 vitest run tests/integration",
    "proxy:detect": "tsx --env-file-if-exists=.env scripts/detect-proxy.ts"
  },
  "dependencies": {
    "fastify": "^5.12.4",
    "undici": "^8.10.2",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0"
  }
}
