# --- Algolia (obrigatorio) ---
ALGOLIA_APP_ID=
ALGOLIA_SEARCH_API_KEY=
ALGOLIA_INDEX_NAME=cobertura_convenios_planos

# --- Autenticacao da API (obrigatorio em producao) ---
# Chave unica entregue ao agente LLM: Authorization: Bearer <API_ACCESS_KEY>
API_ACCESS_KEY=

# --- Opcionais ---
# Interface de escuta. Padrao: 127.0.0.1 (so a propria maquina) fora de
# producao, 0.0.0.0 em producao. Defina para sobrepor.
# HOST=127.0.0.1
ALGOLIA_TIMEOUT_MS=8000
LOG_LEVEL=info
NODE_ENV=production
PORT=3000
