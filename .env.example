# --- Algolia (obrigatorio) ---
ALGOLIA_APP_ID=
ALGOLIA_SEARCH_API_KEY=
ALGOLIA_INDEX_NAME=cobertura_convenios_planos

# --- Autenticacao da API (obrigatorio em producao) ---
# Chave unica entregue ao agente LLM: Authorization: Bearer <API_ACCESS_KEY>
API_ACCESS_KEY=

# --- Opcionais ---
ALGOLIA_TIMEOUT_MS=8000
LOG_LEVEL=info
NODE_ENV=production
PORT=3000
